<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bg_background"
    tools:context=".ui.auth.patient.sing_up.PatientSignUpStep1Activity">

    <!-- العنوان -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:paddingVertical="@dimen/_16sdp"
        android:text="@string/header_title_P1"
        android:textColor="#455A64"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TextContrastCheck" />

    <ScrollView
        android:id="@+id/Subject"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/Sp1_bt_next_P"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- اسم المستخدم -->
            <EditText
                android:id="@+id/Sp1_username_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:autofillHints="name"
                android:background="@drawable/bg_edit_text"
                android:textDirection="rtl"
                android:drawableStart="@drawable/ic_user_edit"
                android:drawablePadding="@dimen/_13sdp"
                android:elevation="@dimen/_1sdp"
                android:fontFamily="@font/cairo_bold"
                android:hint="@string/username"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingStart="@dimen/_20sdp"
                android:paddingEnd="@dimen/_20sdp"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textSize="@dimen/_12sdp"
                tools:ignore="TouchTargetSizeCheck" />

            <!-- النوع -->
            <RadioGroup
                android:id="@+id/Sp1_Gender_P"
                android:layout_width="@dimen/_225sdp"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:orientation="horizontal"
                android:scaleType="centerCrop">

                <RadioButton
                    android:id="@+id/Sp1_male_P"
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/gender_background_selector"
                    android:button="@android:color/transparent"
                    android:drawableStart="@drawable/ic_male"
                    android:elevation="1dp"
                    android:fontFamily="@font/cairo_bold"
                    android:paddingStart="@dimen/_15sdp"
                    android:scaleType="centerCrop"
                    android:text="@string/male"
                    android:textAlignment="center"
                    android:textColor="@drawable/gender_text_selector"
                    android:textSize="@dimen/_15sdp"
                    app:drawableTint="@drawable/gender_text_selector" />

                <RadioButton
                    android:id="@+id/Sp1_female_P"
                    android:layout_width="@dimen/_90sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="@dimen/_40sdp"
                    android:background="@drawable/gender_background_selector"
                    android:button="@android:color/transparent"
                    android:drawableStart="@drawable/ic_female"
                    android:elevation="@dimen/_1sdp"
                    android:fontFamily="@font/cairo_bold"
                    android:paddingStart="@dimen/_15sdp"
                    android:paddingEnd="@dimen/_15sdp"
                    android:scaleType="centerCrop"
                    android:text="@string/female"
                    android:textAlignment="center"
                    android:textColor="@drawable/gender_text_selector"
                    android:textSize="@dimen/_15sdp"
                    app:drawableTint="@drawable/gender_text_selector" />
            </RadioGroup>

            <!-- تاريخ الميلاد -->
            <EditText
                android:id="@+id/Sp1_date_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:autofillHints="creditCardExpirationDate"
                android:background="@drawable/bg_edit_text"
                android:clickable="false"
                android:cursorVisible="false"
                android:drawableStart="@drawable/ic_data"
                android:textDirection="rtl"
                android:elevation="@dimen/_1sdp"
                android:ems="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="@font/cairo_bold"
                android:hint="@string/dateOfBrith"
                android:inputType="date"
                android:maxLines="1"
                android:paddingStart="@dimen/_15sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:scaleType="centerCrop"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textSize="@dimen/_12sdp"
                tools:ignore="TouchTargetSizeCheck" />

            <EditText
                android:id="@+id/Sp1_weight_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/bg_edit_text"
                android:elevation="0.9dp"
                android:fontFamily="@font/cairo_bold"
                android:textDirection="rtl"
                android:hint="@string/weight"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scaleType="centerCrop"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textSize="@dimen/_12sdp"
                tools:ignore="TouchTargetSizeCheck" />

            <EditText
                android:id="@+id/Sp1_height_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:autofillHints="creditCardNumber"
                android:background="@drawable/bg_edit_text"
                android:elevation="0.9dp"
                android:textDirection="rtl"
                android:fontFamily="@font/cairo_bold"
                android:hint="@string/height"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scaleType="centerCrop"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textSize="@dimen/_12sdp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/Sp1_bt_next_P"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/_30sdp"
        android:background="@drawable/bg_ic_background"
        android:fontFamily="@font/cairo_bold"
        android:paddingHorizontal="@dimen/_20sdp"
        android:scaleType="centerCrop"
        android:text="@string/next_button"
        android:textColor="@color/white"
        android:textSize="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Subject"
        tools:ignore="SpeakableTextPresentCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>

