<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bg_background"
    tools:context=".ui.auth.patient.sing_up.PatientSignUpStep2Activity">

    <!-- العنوان -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="@string/header_title_P2"
        android:textColor="@color/Patient_Color"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TextContrastCheck" />

    <!-- Scrollable Form -->
    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/Sp2_bt_next_P"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/Sp2_tv_show_P"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/contact_info"
                android:textColor="@color/Patient_Color"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/Sp2_et_phone_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:autofillHints="phone"
                android:background="@drawable/bg_edit_text"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="@dimen/_13sdp"
                android:elevation="@dimen/_1sdp"
                android:fontFamily="@font/cairo_bold"
                android:hint="@string/phone_number"
                android:maxLines="1"
                android:padding="@dimen/_10sdp"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textDirection="rtl"
                android:textSize="@dimen/_13sdp" />

            <EditText
                android:id="@+id/Sp2_et_email_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_edit_text"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="@dimen/_13sdp"
                android:elevation="@dimen/_1sdp"
                android:fontFamily="@font/cairo_bold"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textSize="@dimen/_13sdp"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/Sp2_tv_secure_P"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/section_title"
                android:textColor="@color/Patient_Color"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/Sp2_et_Pass_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:autofillHints="password"
                android:background="@drawable/bg_edit_text"
                android:drawableStart="@drawable/ic_password_hide"
                android:elevation="@dimen/_1sdp"
                android:fontFamily="@font/cairo_bold"
                android:gravity="end|center_vertical"
                android:hint="@string/password"
                android:inputType="textVisiblePassword"
                android:layoutDirection="ltr"
                android:maxLines="1"
                android:padding="@dimen/_10sdp"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textDirection="ltr"
                android:textSize="@dimen/_13sdp"
                tools:ignore="TouchTargetSizeCheck" />

            <EditText
                android:id="@+id/Sp2_et_coPass_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:autofillHints="no"
                android:background="@drawable/bg_edit_text"
                android:drawableStart="@drawable/ic_password_hide"
                android:elevation="@dimen/_1sdp"
                android:fontFamily="@font/cairo_bold"
                android:gravity="end|center_vertical"
                android:hint="@string/Re_password"
                android:inputType="textVisiblePassword"
                android:layoutDirection="ltr"
                android:maxLines="1"
                android:padding="@dimen/_10sdp"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textDirection="ltr"
                android:textSize="@dimen/_13sdp"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/Sp2_tv_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/address_title_section"
                android:textAlignment="textStart"
                android:textColor="@color/Patient_Color"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/Sp2_tv_city_P"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/city"
                android:textAlignment="textStart"
                android:textColor="@color/Patient_Color"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/Sp2_et_city_P"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_edit_text"
                android:elevation="@dimen/_1sdp"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center_vertical"
                android:hint="@string/city"
                android:paddingStart="@dimen/_20sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/Patient_Color"
                android:textColorHint="#78909C"
                android:textSize="@dimen/_13sdp"
                app:drawableStartCompat="@drawable/ic_location" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/Sp2_bt_next_P"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/_30sdp"
        android:background="@drawable/bg_ic_background"
        android:elevation="10dp"
        android:fontFamily="@font/cairo_bold"
        android:paddingHorizontal="@dimen/_20sdp"
        android:text="@string/next_button"
        android:textColor="@color/white"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />
</androidx.constraintlayout.widget.ConstraintLayout>